rules_version = '2';

// Pravidla pro ŠkolaNet Libčice.
// Zkopíruj celý tento soubor do: Firebase konzole → Firestore Database → karta Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Každá hra žije pod games/{KÓD}. Číst a zapisovat smí jen přihlášený (anonymní) uživatel aplikace.
    match /games/{code} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && code.matches('^[A-Z0-9]{4}$');
      allow delete: if request.auth != null;

      // Žádosti, práva, role, hráči, změny dat, zprávy
      match /{sub}/{id} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
                              && sub in ['requests', 'grants', 'roles', 'players', 'edits', 'messages'];
        allow delete: if request.auth != null;
      }

      // Záznam (log): smí se jen přidávat. Změnit existující záznam nejde.
      // Mazat jde jen při „Ukončit a smazat hru“.
      match /log/{id} {
        allow read, create: if request.auth != null;
        allow update: if false;
        allow delete: if request.auth != null;
      }
    }

    // Všechno ostatní je zakázané (deny by default).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
